<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#016C66" />
  <meta name="robots" content="noindex,follow" />
  <title>وازن | طلب شراكة المؤثرين</title>
  <link rel="icon" type="image/png" href="/wazen_logo.png?v=20260515" />
  <link rel="apple-touch-icon" href="/wazen_logo.png?v=20260515" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
  <style>
    :root{--brand:#016C66;--brand2:#0B8E86;--ink:#071a18;--muted:#64706f;--line:#dce8e6;--bg:#f4faf8;--card:#ffffff;--soft:#eaf5f3;--danger:#b42318;--ok:#047857;--warn:#a15c00;--radius:22px;--shadow:0 18px 50px rgba(1,108,102,.12)}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:"Tajawal",-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;background:radial-gradient(900px 600px at 8% 0%,rgba(1,108,102,.10),transparent 60%),linear-gradient(180deg,#fff,var(--bg));color:var(--ink)}
    button,input,textarea,select{font-family:inherit}button{cursor:pointer}a{color:inherit}.ltr{direction:ltr;text-align:left}.hide{display:none!important}.wrap{width:min(1080px,100%);margin:auto;padding:18px}.hero{display:grid;gap:18px;padding:22px 0 12px}.brand{display:flex;align-items:center;gap:12px}.logo{width:58px;height:58px;border-radius:18px;overflow:hidden;border:1px solid var(--line);background:#fff;box-shadow:var(--shadow)}.logo img{width:100%;height:100%;object-fit:cover}.brand h1{font-size:25px;margin:0;font-weight:900}.brand p{margin:4px 0 0;color:var(--muted);font-size:14px}.heroCard{border:1px solid var(--line);background:linear-gradient(135deg,#fff,#f2fbf9);border-radius:30px;padding:24px;box-shadow:var(--shadow);display:grid;gap:14px}.heroCard h2{margin:0;font-size:30px;font-weight:900;color:var(--brand)}.heroCard p{margin:0;line-height:1.9;color:#344341;font-size:15px}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.step{border:1px solid var(--line);background:#fff;border-radius:20px;padding:14px}.step b{color:var(--brand)}.step span{display:block;color:var(--muted);font-size:13px;margin-top:6px;line-height:1.7}
    .grid{display:grid;gap:14px}.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}.card{border:1px solid var(--line);background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden}.head{padding:18px 18px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:12px}.head h3{margin:0;font-size:19px;font-weight:900}.head p{margin:5px 0 0;color:var(--muted);font-size:13px}.body{padding:18px}.field{display:grid;gap:7px}.field label{font-size:13px;font-weight:800;color:#42504e}input,textarea,select{width:100%;border:1px solid var(--line);border-radius:16px;padding:13px 14px;font-size:15px;background:#fff;color:var(--ink);outline:none}textarea{min-height:110px;resize:vertical;line-height:1.8}input:focus,textarea:focus,select:focus{border-color:rgba(1,108,102,.55);box-shadow:0 0 0 4px rgba(1,108,102,.08)}.btn{border:none;border-radius:16px;background:var(--brand);color:white;padding:13px 16px;font-weight:900;font-size:15px;display:inline-flex;align-items:center;justify-content:center;gap:8px}.btn:hover{filter:brightness(1.05)}.btn:disabled{opacity:.55;cursor:not-allowed}.btn.ghost{background:var(--soft);color:var(--brand)}.btn.line{background:#fff;color:var(--brand);border:1px solid var(--line)}.actions{display:flex;gap:10px;flex-wrap:wrap}.msg{display:none;border:1px solid var(--line);background:#fff;border-radius:16px;padding:12px;line-height:1.7;color:var(--muted)}.msg.show{display:block}.msg.ok{color:var(--ok);border-color:rgba(4,120,87,.25);background:#f0fdf7}.msg.err{color:var(--danger);border-color:rgba(180,35,24,.25);background:#fff5f5}.msg.warn{color:var(--warn);border-color:rgba(161,92,0,.25);background:#fff8ed}.terms{max-height:430px;overflow:auto;border:1px solid var(--line);border-radius:18px;background:#fff;padding:14px}.terms h4{margin:14px 0 6px;color:var(--brand);font-size:15px}.terms p,.terms li{line-height:1.9;color:#33413f;font-size:14px}.terms ol{margin:0;padding-right:20px}.check{display:flex;gap:9px;align-items:flex-start;line-height:1.7;color:#33413f}.check input{width:auto;margin-top:4px}.statGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.stat{border:1px solid var(--line);border-radius:18px;background:#fff;padding:13px}.stat small{color:var(--muted);font-weight:800}.stat b{display:block;margin-top:4px;font-size:22px;color:var(--brand)}.badge{display:inline-flex;border:1px solid var(--line);background:var(--soft);border-radius:999px;padding:7px 10px;font-size:12px;font-weight:900;color:var(--brand)}.footer{color:var(--muted);text-align:center;font-size:12px;padding:24px}.topbar{display:flex;align-items:center;justify-content:space-between;gap:12px}.userbox{display:flex;align-items:center;gap:10px;color:var(--muted);font-size:13px}.avatar{width:34px;height:34px;border-radius:12px;background:var(--soft);display:grid;place-items:center;color:var(--brand);font-weight:900;overflow:hidden}.avatar img{width:100%;height:100%;object-fit:cover}.tableWrap{overflow:auto;border:1px solid var(--line);border-radius:18px}table{width:100%;border-collapse:collapse;background:#fff}th,td{padding:12px;border-bottom:1px solid var(--line);text-align:right;font-size:13px;white-space:nowrap}th{background:#f2faf8;color:var(--brand);font-weight:900}.sectionTitle{font-weight:900;color:var(--brand);font-size:16px;margin:4px 0}.mini{font-size:12px;color:var(--muted);line-height:1.7}.bankBox{border:1px dashed var(--line);border-radius:18px;padding:14px;background:#fbfffe}.noticeTitle{font-size:24px;font-weight:900;color:var(--brand);margin:0}.noticeText{font-size:15px;line-height:2;color:#344341;margin:0}.progressTrack{height:13px;border-radius:999px;background:var(--soft);overflow:hidden;border:1px solid var(--line)}.progressFill{height:100%;width:0%;background:linear-gradient(90deg,var(--brand),var(--brand2));border-radius:999px;transition:width .25s ease}.onlyNotice .body{padding:24px}
    @media(max-width:760px){.wrap{padding:12px}.row,.row3,.steps,.statGrid{grid-template-columns:1fr}.heroCard h2{font-size:24px}.head{align-items:flex-start;flex-direction:column}.actions .btn{flex:1}.topbar{align-items:flex-start;flex-direction:column}th,td{white-space:normal}}
  </style>
</head>
<body>
  <div class="wrap">
    <section class="hero">
      <div class="topbar"><div class="brand"><div class="logo"><img src="/wazen_logo.png" alt="وازن"></div><div><h1>وازن للمؤثرين</h1><p>صفحة الإقرار وطلب الانضمام لشراكات التسويق.</p></div></div><div class="actions"><a class="btn line" href="/">العودة لموقع وازن</a><button id="logoutBtn" class="btn ghost hide">تسجيل خروج</button></div></div>
      <div class="heroCard"><h2>قدّم طلب شراكة تسويقية مع وازن</h2><p>اقرأ الشروط والأحكام، ثم سجل دخولك بالحساب المرتبط بتطبيق وازن، وبعدها عبّئ بياناتك. بعد اعتماد الطلب، تستطيع متابعة الاشتراكات، الأرباح، وحالة الصرف لكل شهر حسب البيانات التي يضيفها فريق وازن من تقارير Apple الرسمية.</p><div class="steps"><div class="step"><b>1. الإقرار</b><span>قراءة الشروط والموافقة عليها.</span></div><div class="step"><b>2. تسجيل الدخول</b><span>الدخول بنفس بريدك المستخدم في وازن.</span></div><div class="step"><b>3. متابعة الأرباح</b><span>عرض حالة كل شهر وهل تم الصرف.</span></div></div></div>
    </section>
    <section id="termsCard" class="card"><div class="head"><div><h3>الشروط والأحكام</h3><p>يجب قراءة البنود والموافقة عليها قبل إرسال الطلب.</p></div><span class="badge">إقرار رسمي</span></div><div class="body grid"><div class="terms"><ol>
      <li><h4>مدة الشراكة</h4><p>تكون مدة الشراكة 6 أشهر من تاريخ بداية الحملة، وتكون قابلة للتمديد أو التعديل حسب أداء المؤثر وبموافقة وازن.</p></li><li><h4>نسبة الخصم للمتابعين</h4><p>نسبة الخصم الأساسية المخصصة لمتابعي المؤثر تكون 10%، ويتم تطبيقها حسب العرض الرسمي المتاح عبر Apple / App Store Connect.</p></li><li><h4>نسبة عمولة المؤثر</h4><p>يحق للمؤثر طلب عمولة بنسبة 10% أو 20% من صافي أرباح وازن المرتبطة بكود الخصم الخاص به، وتخضع النسبة النهائية لموافقة إدارة وازن حسب حجم الحساب، عدد المتابعين، جودة المحتوى، وتقييم فريق وازن. لا تعتمد أي نسبة إلا بعد موافقة الإدارة وظهورها في بيانات الحملة.</p></li><li><h4>شرط تفعيل العمولة</h4><p>لا يتم احتساب أو صرف أي عمولة خلال الشهر الأول إلا بعد تحقيق 12 اشتراكًا فعليًا من خلال كود الخصم خلال أول شهر من بداية الحملة. عند تحقيق الشرط تبدأ أحقية العمولة من الشهر الثاني.</p></li><li><h4>مصدر البيانات الرسمي</h4><p>يتم احتساب الاشتراكات، استخدامات الكود، الأرباح، والعمولات بناءً على التقارير الرسمية الصادرة من Apple / App Store Connect فقط.</p></li><li><h4>صافي أرباح وازن</h4><p>صافي الأرباح هو المبلغ الفعلي المستحق لوازن حسب تقارير Apple بعد خصم عمولة Apple، الضرائب، الاسترجاعات، الإلغاءات، وأي تعديلات مالية.</p></li><li><h4>موعد صرف الأرباح</h4><p>يتم صرف مستحقات المؤثر بعد ظهور التقارير المالية النهائية من Apple واستلام وازن للمبالغ المستحقة، ويخضع الصرف لدورة Apple المالية الرسمية.</p></li><li><h4>الاسترجاع والإلغاء</h4><p>أي اشتراك يتم إلغاؤه، استرجاعه، رفض دفعه، أو تعديله من Apple لا يتم احتسابه ضمن أرباح المؤثر، ويحق لوازن خصمه من التقارير الحالية أو القادمة.</p></li><li><h4>الحساب البنكي</h4><p>يلتزم المؤثر بإدخال بيانات حسابه البنكي بشكل صحيح، ويتحمل مسؤولية أي خطأ في اسم البنك أو رقم الآيبان أو اسم صاحب الحساب.</p></li><li><h4>ملكية كود الخصم</h4><p>كود الخصم مملوك لتطبيق وازن، ويحق لوازن إيقافه، تغييره، أو استبداله عند الحاجة.</p></li><li><h4>استخدام الكود والرابط</h4><p>يلتزم المؤثر باستخدام الكود والرابط الرسمي المعتمد فقط، ولا يحق له إنشاء روابط بديلة أو تقديم عروض غير مصرح بها أو تغيير نسبة الخصم المعلنة.</p></li><li><h4>المحتوى التسويقي</h4><p>يلتزم المؤثر بعرض تطبيق وازن بطريقة صحيحة وغير مضللة، ويمنع تقديم وعود غير رسمية مثل ضمان نزول وزن محدد أو ضمان نتائج صحية أو ذكر خصومات غير معتمدة.</p></li><li><h4>التقارير</h4><p>يحق للمؤثر الاطلاع على تقرير يوضح أداء الكود وحالة الصرف لكل شهر، ولا يعتبر أي تقرير نهائيًا إلا بعد اعتماد بيانات Apple الرسمية.</p></li><li><h4>السرية وإنهاء الشراكة</h4><p>يلتزم المؤثر بسرية تفاصيل العمولة والتقارير، ويحق لوازن إنهاء الشراكة أو إيقاف الكود في حال إساءة الاستخدام أو مخالفة الشروط.</p></li>
    </ol></div><label class="check"><input id="agreeTerms" type="checkbox"> <span>أقر بالموافقة على الشروط والأحكام، وأوافق على أن تقارير Apple الرسمية هي المصدر المعتمد لاحتساب الاشتراكات والأرباح والعمولات.</span></label><div class="actions"><button id="continueBtn" class="btn">متابعة وتسجيل الدخول</button></div><div id="termsMsg" class="msg"></div></div></section>
    <section id="loginCard" class="card hide"><div class="head"><div><h3>تسجيل الدخول</h3><p>استخدم نفس البريد المرتبط بحسابك في تطبيق وازن.</p></div></div><div class="body grid"><button id="googleBtn" class="btn">تسجيل الدخول عبر Google</button><div class="row"><input id="emailLogin" placeholder="البريد الإلكتروني"><input id="passLogin" placeholder="كلمة المرور" type="password"></div><button id="emailBtn" class="btn ghost">تسجيل الدخول بالبريد</button><div id="loginMsg" class="msg"></div></div></section>
    <section id="statusOnlyCard" class="card hide onlyNotice"><div class="head"><div><h3 id="statusTitle">حالة طلبك</h3><p id="statusSub">متابعة حالة حساب المؤثر.</p></div><span id="statusBadge" class="badge">بانتظار</span></div><div class="body grid"><p id="statusText" class="noticeText">تم تقديم طلبك وسيتم إرسال بريد إلكتروني لك عند القبول.</p><div id="activationProgressBox" class="grid hide"><div class="statGrid"><div class="stat"><small>استخدامات كودك الحالية</small><b id="codeUsesStat">0</b></div><div class="stat"><small>المطلوب لتفعيل الأرباح</small><b id="codeGoalStat">12</b></div><div class="stat"><small>المتبقي</small><b id="codeRemainingStat">12</b></div><div class="stat"><small>الكود المعتمد</small><b id="codeStat" class="ltr">—</b></div></div><div class="progressTrack"><div id="codeProgressBar" class="progressFill"></div></div><div id="codeProgressText" class="mini">عند 12 استخدام لكودك سيتم عرض الإحصائيات والأرباح.</div></div><div id="statusAdminNotes" class="msg"></div><div class="actions"><button id="statusReloadBtn" class="btn ghost">تحديث الحالة</button></div></div></section>
    <section id="formCard" class="card hide"><div class="head"><div><h3>بيانات المؤثر والحملة</h3><p>يمكنك تعديل بياناتك قبل اعتماد الطلب من فريق وازن.</p></div><span id="formStatus" class="badge">طلب جديد</span></div><div class="body grid"><div class="userbox"><span id="avatar" class="avatar">و</span><div><b id="userName">—</b><div id="userEmail" class="ltr">—</div></div></div><div class="row"><div class="field"><label>اسم المؤثر</label><input id="name" placeholder="مثال: محمد أحمد"></div><div class="field"><label>البريد المستخدم في تطبيق وازن</label><input id="appEmail" placeholder="example@email.com"></div></div><div class="row"><div class="field"><label>رقم التواصل</label><input id="phone" class="ltr" placeholder="05xxxxxxxx"></div><div class="field"><label>كود الخصم المطلوب</label><input id="desiredCode" class="ltr" placeholder="مثال: MOHAMMED10"></div></div><div class="row"><div class="field"><label>حساب TikTok</label><input id="tiktok" class="ltr" placeholder="@username"></div><div class="field"><label>حساب Snapchat / Instagram اختياري</label><input id="social" class="ltr" placeholder="@username"></div></div><div class="row3"><div class="field"><label>نسبة الخصم للمتابعين</label><input id="discountRequest" value="10%" readonly></div><div class="field"><label>نسبة العمولة المطلوبة</label><select id="requestedCommissionRate"><option value="10">10% من صافي أرباح وازن</option><option value="15">15% من صافي أرباح وازن</option><option value="20">20% من صافي أرباح وازن</option></select></div><div class="field"><label>المدينة / الدولة</label><input id="location" placeholder="مثال: الدمام، السعودية"></div></div><div class="mini">ملاحظة: اختيار نسبة العمولة هنا يعتبر طلبًا من المؤثر، والنسبة النهائية تعتمد فقط بعد موافقة إدارة وازن.</div><div class="field"><label>ملاحظات المؤثر</label><textarea id="notes" placeholder="اكتب أي ملاحظات أو تفاصيل عن الحملة والجمهور المستهدف"></textarea></div>
      <div class="bankBox grid"><div><div class="sectionTitle">بيانات الحساب البنكي</div><div class="mini">تستخدم لغرض تحويل المستحقات بعد اعتمادها. تأكد من صحة اسم البنك والآيبان.</div></div><div class="row"><div class="field"><label>اسم البنك</label><input id="bankName" placeholder="مثال: مصرف الراجحي"></div><div class="field"><label>اسم صاحب الحساب</label><input id="bankAccountName" placeholder="الاسم كما يظهر في البنك"></div></div><div class="row"><div class="field"><label>رقم الآيبان IBAN</label><input id="iban" class="ltr" placeholder="SA0000000000000000000000"></div><div class="field"><label>ملاحظات بنكية اختيارية</label><input id="bankNotes" placeholder="أي ملاحظة إضافية"></div></div></div>
      <label class="check"><input id="finalAgree" type="checkbox"> <span>أؤكد صحة البيانات وأعلم أن نسبة الخصم للمتابعين 10%، وأن نسبة العمولة المطلوبة تخضع لموافقة إدارة وازن.</span></label><div class="actions"><button id="saveBtn" class="btn">إرسال / تحديث الطلب</button><button id="statsBtn" type="button" class="btn line">احصائياتي</button><button id="reloadBtn" class="btn ghost">تحديث البيانات</button></div><div id="formMsg" class="msg"></div></div></section>
    <section id="reportCard" class="card hide"><div class="head"><div><h3>احصائياتي وأرباحي المقدرة</h3><p>جدول شهري يوضح الاشتراكات، صافي Apple، أرباحك المقدرة، وحالة الصرف حسب البيانات المعتمدة من فريق وازن.</p></div><button id="closeStatsBtn" type="button" class="btn ghost">إخفاء</button></div><div class="body grid"><div class="statGrid"><div class="stat"><small>عدد الاشتراكات</small><b id="subsCount">0</b></div><div class="stat"><small>صافي Apple</small><b id="appleNet">0</b></div><div class="stat"><small>عمولة المؤثر</small><b id="commissionAmount">0</b></div><div class="stat"><small>حالة الصرف الحالية</small><b id="paymentStatus">—</b></div></div><div class="row"><div class="field"><label>تاريخ بداية الحملة</label><input id="campaignStart" readonly></div><div class="field"><label>تاريخ نهاية الحملة</label><input id="campaignEnd" readonly></div></div><div class="row"><div class="field"><label>حالة الحملة</label><input id="campaignStatus" readonly></div><div class="field"><label>الكود المعتمد</label><input id="approvedCode" readonly class="ltr"></div></div><div class="field"><label>ملاحظات وازن</label><textarea id="adminNotes" readonly></textarea></div><div><div class="sectionTitle">حالة الصرف حسب الأشهر</div><div id="monthlyTable" class="tableWrap"></div></div><div><div class="sectionTitle">عمليات كودك من تقارير Apple</div><div id="operationsTable" class="tableWrap"></div><div class="mini">تظهر العمليات التي اعتمدها فريق وازن من تقارير Apple الرسمية ضمن فترة التقرير المحددة.</div></div><div class="actions"><button id="influencerPdfBtn" type="button" class="btn line">تصدير / حفظ PDF</button></div></div></section>
    <div class="footer">© وازن — صفحة رسمية لشراكات المؤثرين.</div>
  </div>
  <script src="https://www.gstatic.com/firebasejs/10.12.4/firebase-app-compat.js"></script><script src="https://www.gstatic.com/firebasejs/10.12.4/firebase-auth-compat.js"></script><script src="https://www.gstatic.com/firebasejs/10.12.4/firebase-firestore-compat.js"></script>
  <script>
    const firebaseConfig={apiKey:'AIzaSyD9y9FED7L-s0unONweN-5LhmwEdipXYUo',authDomain:'wazenfapp.firebaseapp.com',projectId:'wazenfapp',storageBucket:'wazenfapp.appspot.com',messagingSenderId:'209409669834',appId:'1:209409669834:web:9e33eba07509ee28a29233'};
    firebase.initializeApp(firebaseConfig); const auth=firebase.auth(); const db=firebase.firestore(); const FieldValue=firebase.firestore.FieldValue; const $=id=>document.getElementById(id); let currentUser=null; const docRef=()=>db.collection('influencerApplications').doc(currentUser.uid);
    function msg(id,text,type='warn'){const el=$(id);el.textContent=text||'';el.className='msg '+(text?'show ':'')+type} function clean(v){return String(v||'').trim()} function money(v){const n=Number(v||0);return n.toLocaleString('ar-SA',{maximumFractionDigits:2})} function safeDate(v){try{if(!v)return''; if(v.toDate)v=v.toDate(); const d=new Date(v); if(isNaN(d))return''; return d.toLocaleDateString('ar-SA')}catch(_){return''}} function escapeHtml(v){return String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))} function statusAr(s){return ({draft:'مسودة',pending:'بانتظار المراجعة',approved:'معتمد',active:'نشطة',paused:'متوقفة',ended:'منتهية',rejected:'مرفوض',deleted:'محذوف'})[String(s||'pending')]||String(s||'بانتظار المراجعة')}
    $('continueBtn').onclick=()=>{if(!$('agreeTerms').checked){msg('termsMsg','يجب الموافقة على الشروط قبل المتابعة.','err');return}$('loginCard').classList.remove('hide');$('loginCard').scrollIntoView({behavior:'smooth'});msg('termsMsg','تم تأكيد الإقرار. سجّل دخولك لإكمال الطلب.','ok')}; $('googleBtn').onclick=async()=>{const p=new firebase.auth.GoogleAuthProvider();p.setCustomParameters({prompt:'select_account'});try{await auth.signInWithPopup(p)}catch(e){try{await auth.signInWithRedirect(p)}catch(_){msg('loginMsg','تعذر تسجيل الدخول عبر Google.','err')}}}; $('emailBtn').onclick=async()=>{try{await auth.signInWithEmailAndPassword(clean($('emailLogin').value),$('passLogin').value)}catch(e){msg('loginMsg','تعذر تسجيل الدخول بالبريد. تأكد من البيانات.','err')}}; $('logoutBtn').onclick=()=>auth.signOut(); $('reloadBtn').onclick=loadApplication;
    auth.onAuthStateChanged(async user=>{currentUser=user;if(!user){$('logoutBtn').classList.add('hide');$('formCard').classList.add('hide');$('statusOnlyCard').classList.add('hide');$('reportCard').classList.add('hide');return}$('logoutBtn').classList.remove('hide');$('loginCard').classList.add('hide');$('formCard').classList.add('hide');$('statusOnlyCard').classList.add('hide');$('reportCard').classList.add('hide');$('userName').textContent=user.displayName||'مستخدم وازن';$('userEmail').textContent=user.email||user.uid;$('appEmail').value=$('appEmail').value||user.email||'';if(user.photoURL){$('avatar').innerHTML=`<img src="${user.photoURL}">`}else{$('avatar').textContent=(user.displayName||user.email||'و')[0]}await loadApplication();});
    function isoDate(v){try{if(!v)return''; if(v.toDate)v=v.toDate(); const d=new Date(v); if(isNaN(d))return''; return d.toISOString().slice(0,10)}catch(_){return''}}
    function monthIso(m){const raw=String(m?.month||m?.from||m?.firstDate||'').trim(); if(/^\d{4}-\d{2}$/.test(raw))return raw+'-01'; if(/^\d{4}-\d{2}-\d{2}/.test(raw))return raw.slice(0,10); return ''}
    function filterMonthsByReport(x,months){const from=isoDate(x.reportFrom||x.reportStart),to=isoDate(x.reportTo||x.reportEnd);if(!from&&!to)return months;return months.filter(m=>{const d=monthIso(m); if(!d)return true; if(from&&d<from)return false; if(to&&d>to)return false; return true})}
    function isApprovedAccount(x){const s=String(x.status||'pending'),c=String(x.campaignStatus||s);return ['approved','active'].includes(s)||['approved','active'].includes(c)}
    function codeUses(x){return Number(x.preActivationCodeUses??x.codeUses??x.subscriberCount??0)}
    function earningsIsEnabled(x){return x.earningsEnabled===true||x.profitEnabled===true||x.showStats===true||codeUses(x)>=12}
    function showStatusOnly(x,mode){$('formCard').classList.add('hide');$('reportCard').classList.add('hide');$('statusOnlyCard').classList.remove('hide');const uses=codeUses(x),goal=12,remaining=Math.max(goal-uses,0),pct=Math.max(0,Math.min(100,(uses/goal)*100));$('statusAdminNotes').className='msg';$('statusAdminNotes').textContent='';$('activationProgressBox').classList.add('hide');if(mode==='earnings'){$('statusTitle').textContent='حسابك غير مفعل للأرباح حتى الآن';$('statusSub').textContent='تم قبولك في حملة وازن، لكن عرض الإحصائيات والأرباح يبدأ بعد استيفاء شرط التفعيل.';$('statusBadge').textContent='غير مفعل للأرباح';$('statusText').textContent='حسابك الآن غير مفعل للأرباح. عند 12 استخدام لكودك سيتم عرض الإحصائيات، ويمكن لإدارة وازن تفعيل حسابك يدويًا قبل ذلك.';$('activationProgressBox').classList.remove('hide');$('codeUsesStat').textContent=uses;$('codeGoalStat').textContent=goal;$('codeRemainingStat').textContent=remaining;$('codeStat').textContent=x.approvedCode||x.desiredCode||'—';$('codeProgressBar').style.width=pct+'%';$('codeProgressText').textContent=remaining>0?`باقي ${remaining} استخدام لتفعيل عرض الأرباح والإحصائيات.`:'تم الوصول للحد المطلوب، وسيتم عرض الإحصائيات بعد تحديث الاعتماد.';}else if(mode==='deleted'){$('statusTitle').textContent='حالة حساب المؤثر';$('statusSub').textContent='تم إيقاف أو حذف طلب الشراكة.';$('statusBadge').textContent='غير مؤهل';$('statusText').textContent=x.deletionReason||'تم إيقاف أو حذف طلب الشراكة من قبل إدارة وازن.';}else if(mode==='rejected'){$('statusTitle').textContent='حالة طلبك';$('statusSub').textContent='تمت مراجعة الطلب.';$('statusBadge').textContent='غير مقبول';$('statusText').textContent=x.rejectionReason||x.adminNotes||'نعتذر، لم يتم قبول طلبك في حملة المؤثرين حاليًا.';}else{$('statusTitle').textContent='تم تقديم طلبك';$('statusSub').textContent='طلبك تحت مراجعة فريق وازن.';$('statusBadge').textContent='بانتظار القبول';$('statusText').textContent='تم تقديم طلبك وسيتم إرسال بريد إلكتروني لك عند القبول.';}if(x.adminNotes&&mode!=='rejected'){$('statusAdminNotes').textContent=x.adminNotes;$('statusAdminNotes').className='msg show warn'}$('statusOnlyCard').scrollIntoView({behavior:'smooth'})}
    async function loadApplication(){if(!currentUser)return;try{const d=await docRef().get();if(!d.exists){$('formStatus').textContent='طلب جديد';$('statusOnlyCard').classList.add('hide');$('reportCard').classList.add('hide');$('formCard').classList.remove('hide');renderReport({});$('formCard').scrollIntoView({behavior:'smooth'});return}const x=d.data()||{};$('formStatus').textContent=statusAr(x.status);$('name').value=x.name||'';$('appEmail').value=x.appEmail||currentUser.email||'';$('phone').value=x.phone||'';$('desiredCode').value=x.desiredCode||x.code||'';$('tiktok').value=x.tiktok||'';$('social').value=x.social||'';$('discountRequest').value=x.discountRequest||'10%';$('requestedCommissionRate').value=String(x.requestedCommissionRate||10);$('location').value=x.location||'';$('notes').value=x.notes||'';$('bankName').value=x.bankName||'';$('bankAccountName').value=x.bankAccountName||'';$('iban').value=x.iban||'';$('bankNotes').value=x.bankNotes||'';$('finalAgree').checked=x.finalAgreement===true;const s=String(x.status||'pending'),c=String(x.campaignStatus||s);if(s==='deleted'||c==='deleted'){showStatusOnly(x,'deleted');return}if(s==='rejected'||c==='rejected'){showStatusOnly(x,'rejected');return}if(!isApprovedAccount(x)){showStatusOnly(x,'pending');return}if(!earningsIsEnabled(x)){showStatusOnly(x,'earnings');return}$('statusOnlyCard').classList.add('hide');$('formCard').classList.remove('hide');renderReport(x);msg('formMsg','تم تحميل بياناتك.','ok');$('formCard').scrollIntoView({behavior:'smooth'})}catch(e){msg('formMsg','تعذر تحميل البيانات. قد تحتاج إلى تسجيل الدخول أو تحديث الصفحة.','err')}}
    function renderReport(x){$('subsCount').textContent=Number(x.subscriberCount||0);$('appleNet').textContent=money(x.appleNetProfit||0);$('commissionAmount').textContent=money(x.commissionAmount||0);$('paymentStatus').textContent=x.paymentStatus||'—';$('campaignStart').value=safeDate(x.campaignStart);$('campaignEnd').value=safeDate(x.campaignEnd);$('campaignStatus').value=statusAr(x.campaignStatus||x.status);$('approvedCode').value=x.approvedCode||x.desiredCode||'';$('adminNotes').value=x.adminNotes||'';const allMonths=Array.isArray(x.monthlyPayments)?x.monthlyPayments:[];const months=filterMonthsByReport(x,allMonths).filter(m=>m.visibleToInfluencer!==false);$('monthlyTable').innerHTML=months.length?`<table><thead><tr><th>الشهر</th><th>الاشتراكات</th><th>صافي Apple</th><th>نوع العمولة</th><th>نسبة/قيمة العمولة</th><th>أرباحك المقدرة</th><th>صافي وازن</th><th>حالة الصرف</th><th>تاريخ الصرف</th><th>ملاحظات</th></tr></thead><tbody>${months.map(m=>{const type=m.commissionType||x.commissionType||'percent';const typeTxt=type==='fixed'?'مبلغ ثابت':(type==='hybrid'?'نسبة + مبلغ ثابت':'نسبة');const rate=Number(m.commissionRate??x.commissionRate??10);const fixed=Number(m.fixedCommission??x.fixedCommission??0);const valueTxt=type==='fixed'?(money(fixed)+' لكل اشتراك'):(type==='hybrid'?(rate+'% + '+money(fixed)+' لكل اشتراك'):(rate+'%'));return `<tr><td>${escapeHtml(m.month||'—')}</td><td>${Number(m.subscribers||0)}</td><td>${money(m.appleNetProfit||0)}</td><td>${typeTxt}</td><td>${valueTxt}</td><td>${money(m.commissionAmount||0)}</td><td>${money(m.wazenNetProfit||0)}</td><td>${escapeHtml(m.paymentStatus||'—')}</td><td>${escapeHtml(m.paidAt||'—')}</td><td>${escapeHtml(m.notes||'—')}</td></tr>`}).join('')}</tbody></table>`:'<div class="mini" style="padding:14px">لا توجد بيانات شهرية ظاهرة ضمن فترة التقرير الحالية. ستظهر البيانات بعد اعتماد فريق وازن لتقارير Apple الرسمية.</div>'}
    $('statsBtn').onclick=()=>{$('reportCard').classList.remove('hide');$('reportCard').scrollIntoView({behavior:'smooth'});}; $('closeStatsBtn').onclick=()=>{$('reportCard').classList.add('hide');}; $('statusReloadBtn').onclick=loadApplication;
    $('saveBtn').onclick=async()=>{if(!currentUser){msg('formMsg','سجّل دخولك أولاً.','err');return}if(!$('finalAgree').checked){msg('formMsg','يجب تأكيد الموافقة على الشروط قبل الإرسال.','err');return}const payload={uid:currentUser.uid,email:currentUser.email||'',displayName:currentUser.displayName||'',photoURL:currentUser.photoURL||'',name:clean($('name').value),appEmail:clean($('appEmail').value).toLowerCase(),phone:clean($('phone').value),desiredCode:clean($('desiredCode').value).toUpperCase().replace(/[^A-Z0-9]/g,''),tiktok:clean($('tiktok').value),social:clean($('social').value),discountRequest:clean($('discountRequest').value)||'10%',requestedCommissionRate:Number($('requestedCommissionRate').value||10),location:clean($('location').value),notes:clean($('notes').value),bankName:clean($('bankName').value),bankAccountName:clean($('bankAccountName').value),iban:clean($('iban').value).toUpperCase().replace(/\s+/g,''),bankNotes:clean($('bankNotes').value),termsAccepted:true,finalAgreement:true,updatedAt:FieldValue.serverTimestamp()};if(!payload.name||!payload.appEmail||!payload.phone||!payload.desiredCode||!payload.tiktok){msg('formMsg','عبّئ الاسم، البريد، رقم التواصل، الكود المطلوب، وحساب TikTok.','err');return}try{const oldSnap=await docRef().get();if(!oldSnap.exists){payload.status='pending';payload.campaignStatus='pending';payload.createdAt=FieldValue.serverTimestamp()}else{const old=oldSnap.data()||{};if(!isApprovedAccount(old)){payload.status=old.status||'pending';payload.campaignStatus=old.campaignStatus||'pending'}}await docRef().set(payload,{merge:true});msg('formMsg','تم تقديم طلبك وسيتم إرسال بريد إلكتروني لك عند القبول.','ok');await loadApplication()}catch(e){msg('formMsg','تعذر حفظ الطلب. إذا استمرت المشكلة تواصل مع دعم وازن.','err')}};
  </script>

<script>
(function(){
  function W$(id){return document.getElementById(id)}
  function esc(v){return String(v??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]))}
  function num(v){const n=Number(v||0);return isFinite(n)?n:0}
  function sar(v){return new Intl.NumberFormat('ar-SA',{style:'currency',currency:'SAR',maximumFractionDigits:2}).format(num(v))}
  function pd(v){try{if(!v)return '—'; if(v.toDate)v=v.toDate(); const d=new Date(v); if(isNaN(d))return String(v||'—'); return d.toLocaleDateString('ar-SA')}catch(_){return String(v||'—')}}
  function iso(v){try{if(!v)return ''; if(v.toDate)v=v.toDate(); const d=new Date(v); if(isNaN(d))return ''; return d.toISOString().slice(0,10)}catch(_){return ''}}
  function monthD(m){const raw=String(m?.month||m?.from||m?.firstDate||'').trim(); if(/^\d{4}-\d{2}$/.test(raw))return raw+'-01'; if(/^\d{4}-\d{2}-\d{2}/.test(raw))return raw.slice(0,10); return ''}
  function filterPeriod(x,arr){const from=iso(x.reportFrom||x.reportStart),to=iso(x.reportTo||x.reportEnd); if(!from&&!to)return arr||[]; return (arr||[]).filter(r=>{const d=monthD(r)||String(r.firstDate||r.from||'').slice(0,10); if(!d)return true; if(from&&d<from)return false; if(to&&d>to)return false; return true})}
  function ctype(t){return t==='fixed'?'مبلغ ثابت':(t==='hybrid'?'نسبة + مبلغ ثابت':'نسبة')}
  window.__lastInfluencerReport=null;
  const oldRender=typeof renderReport==='function'?renderReport:null;
  if(oldRender){renderReport=function(x){oldRender(x); window.__lastInfluencerReport=x||{}; const ops=filterPeriod(x,Array.isArray(x.appleImports)?x.appleImports:[]).filter(r=>r.visibleToInfluencer!==false); const box=W$('operationsTable'); if(box){box.innerHTML=ops.length?`<table><thead><tr><th>الشهر</th><th>الفترة</th><th>الكود</th><th>الاستخدامات</th><th>مدفوع</th><th>تجارب</th><th>صافي Apple</th><th>المصدر</th></tr></thead><tbody>${ops.map(r=>`<tr><td>${esc(r.month||'—')}</td><td>${pd(r.from||r.firstDate)} إلى ${pd(r.to||r.lastDate)}</td><td class="ltr">${esc(r.code||x.approvedCode||x.desiredCode||'')}</td><td>${num(r.usage)}</td><td>${num(r.paid)}</td><td>${num(r.trials)}</td><td>${sar(r.appleNetProfit)}</td><td>${esc(r.source||'Apple')}</td></tr>`).join('')}</tbody></table>`:'<div class="mini" style="padding:14px">لا توجد عمليات ظاهرة لك حتى الآن ضمن فترة التقرير الحالية.</div>';}
      const btn=W$('influencerPdfBtn'); if(btn)btn.onclick=()=>printInfluencerReport(window.__lastInfluencerReport||{});
    }}
  function printInfluencerReport(x){const months=filterPeriod(x,Array.isArray(x.monthlyPayments)?x.monthlyPayments:[]).filter(m=>m.visibleToInfluencer!==false); const ops=filterPeriod(x,Array.isArray(x.appleImports)?x.appleImports:[]).filter(r=>r.visibleToInfluencer!==false); const t={subs:months.reduce((s,m)=>s+num(m.subscribers),0)||num(x.subscriberCount),apple:months.reduce((s,m)=>s+num(m.appleNetProfit),0)||num(x.appleNetProfit),commission:months.reduce((s,m)=>s+num(m.commissionAmount),0)||num(x.commissionAmount),wazen:months.reduce((s,m)=>s+num(m.wazenNetProfit),0)||num(x.wazenNetProfit)}; const code=x.approvedCode||x.desiredCode||'—'; const monthRows=months.length?months.map((m,i)=>`<tr><td>${i+1}</td><td>${esc(m.month||'—')}</td><td>${num(m.subscribers)}</td><td>${sar(m.appleNetProfit)}</td><td>${ctype(m.commissionType||x.commissionType)}</td><td>${sar(m.commissionAmount)}</td><td>${sar(m.wazenNetProfit)}</td><td>${esc(m.paymentStatus||'—')}</td></tr>`).join(''):'<tr><td colspan="8">لا توجد بيانات شهرية ظاهرة.</td></tr>'; const opRows=ops.length?ops.map((r,i)=>`<tr><td>${i+1}</td><td>${esc(r.month||'—')}</td><td>${pd(r.from||r.firstDate)} إلى ${pd(r.to||r.lastDate)}</td><td>${num(r.usage)}</td><td>${num(r.paid)}</td><td>${num(r.trials)}</td><td>${sar(r.appleNetProfit)}</td></tr>`).join(''):'<tr><td colspan="7">لا توجد عمليات Apple ظاهرة.</td></tr>'; const w=window.open('','_blank'); if(!w){alert('اسمح بالنوافذ المنبثقة لحفظ PDF.');return} w.document.write(`<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><title>تقرير مؤثر وازن</title><style>@page{size:A4;margin:12mm}body{font-family:Arial,Tahoma,sans-serif;direction:rtl;background:#f7faf9}.page{background:white;width:210mm;min-height:297mm;margin:auto;padding:14mm}.noPrint{text-align:center;background:#016C66;color:white;padding:12px}button{padding:10px 18px;border:0;border-radius:10px;font-weight:800}table{width:100%;border-collapse:collapse;margin:10px 0}th,td{border:1px solid #333;padding:8px;font-size:11.5px}th{background:#111;color:#fff}.box{border:1.5px solid #111;padding:12px}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.head{border:2px solid #111;padding:14px;display:flex;justify-content:space-between;align-items:center}h1{margin:0;font-size:22px}h2{border-bottom:1.5px solid #111;padding-bottom:8px}.ltr{direction:ltr;text-align:left}@media print{body{background:white}.noPrint{display:none}.page{margin:0}}</style></head><body><div class="noPrint"><button onclick="print()">طباعة / حفظ PDF</button></div><section class="page"><div class="head"><div><h1>تقرير مؤثر وازن</h1><p>${esc(x.name||x.displayName||'—')} — <span class="ltr">${esc(code)}</span></p></div><img src="/wazen_logo.png" width="48"></div><h2>الملخص المالي</h2><div class="grid"><div class="box">الاستخدامات<br><b>${t.subs}</b></div><div class="box">صافي Apple<br><b>${sar(t.apple)}</b></div><div class="box">عمولتك<br><b>${sar(t.commission)}</b></div><div class="box">حالة الصرف<br><b>${esc(x.paymentStatus||'—')}</b></div></div><h2>الأشهر</h2><table><thead><tr><th>#</th><th>الشهر</th><th>الاستخدامات</th><th>صافي Apple</th><th>نوع العمولة</th><th>عمولتك</th><th>صافي وازن</th><th>الصرف</th></tr></thead><tbody>${monthRows}</tbody></table><h2>عمليات Apple</h2><table><thead><tr><th>#</th><th>الشهر</th><th>الفترة</th><th>الاستخدامات</th><th>مدفوع</th><th>تجارب</th><th>صافي Apple</th></tr></thead><tbody>${opRows}</tbody></table><p>هذا التقرير للمتابعة فقط ويعتمد على بيانات Apple الرسمية التي يضيفها فريق وازن.</p></section></body></html>`); w.document.close(); setTimeout(()=>w.print(),700)}
})();
</script>
</body>
</html>